# Application
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
APP_NAME=production-rag-humanloop-agent
SEED=1234

# LLM Provider (fake|openai|anthropic|mistral)
LLM_PROVIDER=fake
LLM_MODEL=fake-small
LLM_API_KEY=
LLM_BASE_URL=
# For self-hosted vLLM: http://localhost:8000
# For Mistral: https://api.mistral.ai/v1

# Embeddings (fake|openai|mistral)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embed
EMBEDDING_DIM=384

# Retrieval
VECTOR_BACKEND=memory
# memory: in-memory (dev), pgvector: Postgres with pgvector (prod)
TOP_K=4
MIN_RETRIEVAL_SCORE=0.25
# Abstain if best retrieved doc scores below this; helps avoid hallucination.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Persistence
DATABASE_URL=postgresql://prag:prag@localhost:5432/prag
# Used for pgvector and audit tables when vector_backend=pgvector

CHECKPOINTER=memory
# memory: in-memory (dev)
# sqlite: ./prag_checkpoints.sqlite (local durable)
# postgres: uses DATABASE_URL above (prod durable)
SQLITE_PATH=./prag_checkpoints.sqlite

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag-humanloop-agent
OTEL_EXPORTER_OTLP_ENDPOINT=

# Human-in-the-Loop
AUTO_APPROVE=false
# Set to true only for CI/smoke tests. Production: false (humans must approve).
